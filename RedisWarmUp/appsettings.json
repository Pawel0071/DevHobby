{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Mongo": "mongodb://mongo_user:mongo_pass@mongodb:27017/rpgdb?authSource=admin",
    "Redis": "redis:6379"
  },
  "RedisWarmUp": {
    "CollectionsToCache": [
      "Characters",
      "Items",
      "Skills",
      "Quests",
      "Worlds"
    ],
    "BatchSize": 100,
    "IntervalSeconds": 300,
    "CacheExpirySeconds": 3600
  }
}
