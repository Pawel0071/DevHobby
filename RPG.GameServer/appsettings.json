{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://tempo:4317"
  },
  "Outbox": { "Enabled": true, "Role": "Producer" }
}
