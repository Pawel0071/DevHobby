<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RootNamespace>RPG.GameServer</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(RunConfiguration)' == 'https' "/>
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'http' "/>
  <ItemGroup>
    <Protobuf Include="Protos\v1\character.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\session.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\world.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\interaction.proto" GrpcServices="Server" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\item.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\skill.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\npc.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\mapobject.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\quest.proto" GrpcServices="Server,Client" ProtoRoot="Protos\v1" />
    <Protobuf Include="Protos\v1\common.proto" GrpcServices="None" ProtoRoot="Protos\v1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.71.0"/>
    <PackageReference Include="OpenTelemetry" Version="1.10.0"/>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0"/>
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.10.0-beta.1"/>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.10.0"/>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.10.0"/>
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.10.0"/>
    <PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.10.0-beta.1"/>
    <PackageReference Include="Polly" Version="8.6.4"/>
    <PackageReference Include="StackExchange.Redis" Version="2.9.32"/>
    <PackageReference Include="Vishwam.RabbitMqLibrary.Queuing" Version="0.0.6"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../RPG.Infrastructure/appsettings.infrastructure.json">
      <Link>appsettings.infrastructure.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../RPG.Infrastructure/appsettings.infrastructure.Development.json">
      <Link>appsettings.infrastructure.Development.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPG.Application\RPG.Application.csproj"/>
    <ProjectReference Include="..\RPG.Core\RPG.Core.csproj"/>
    <ProjectReference Include="..\RPG.AI\RPG.AI.csproj"/>
  </ItemGroup>

</Project>
